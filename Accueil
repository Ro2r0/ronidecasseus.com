  <section class="services" id="services">
    <div class="container">
      <div class="services-header">
        <span class="eyebrow">What We Offer</span>
        <h2 class="section-title">Work that changes you from the inside out.</h2>
        <p>Every service is built around one truth: becoming better is not about fixing yourself — it's about choosing to grow, consistently and honestly.</p>
        <div class="gold-line center-line"></div>
      </div>

      <div class="services-grid">
        <article class="service-card">
          <div class="service-number">01</div>
          <h3>1:1 <span>Maturity</span> Coaching</h3>

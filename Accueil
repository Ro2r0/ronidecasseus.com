        text-align: center;
      }

      .hero-eyebrow {
        justify-content: center;
      }

      .hero-eyebrow::before {
        display: none;
      }

      .cta-group {
        justify-content: center;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
        align-items: center;
      }

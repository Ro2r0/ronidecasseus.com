      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--gray);
      z-index: 2;
    }

    .hero-badge span {
      width: 8px;
      height: 8px;
      background: var(--red);
      border-radius: 50%;
      display: inline-block;
    }

